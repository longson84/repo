#!/usr/bin/env python3
"""Memorable local launcher.

Usage:
  python3 run repo
  python3 run repo ~/Projects
"""

from __future__ import annotations

import os
from pathlib import Path
import sys

HERE = Path(__file__).resolve().parent
COMPANION = HERE / "companion" / "server.py"
DEFAULT_ROOT = Path.home() / "Projects"


def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"-h", "--help", "help"}:
        print(__doc__.strip())
        return 0
    command = argv[0]
    if command not in {"repo", "ui", "start"}:
        print(f"Unknown command: {command}", file=sys.stderr)
        print(__doc__.strip(), file=sys.stderr)
        return 2
    root = argv[1] if len(argv) > 1 else str(DEFAULT_ROOT)
    os.execv(
        sys.executable,
        [sys.executable, str(COMPANION), "--root", root, "--ui", *argv[2:]],
    )


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
